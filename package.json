{
  "name": "linear-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/api build",
    "start": "bun run --cwd apps/api start",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint apps packages",
    "format": "oxfmt apps packages"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "oxlint": "^0.18.0",
    "typescript": "^5.6.0"
  }
}
